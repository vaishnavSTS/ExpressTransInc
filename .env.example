# Copy to .env.production (or set in your hosting provider) before building.
# All VITE_* values are embedded in the public JavaScript bundle. Never put secrets here.

# Verified production origin, no trailing slash. Used for canonical URLs, Open Graph
# URLs, structured data and sitemap.xml. Leave empty until the domain is confirmed.
VITE_SITE_URL=

# Set to "true" ONLY for the production deployment on the confirmed domain.
# Anything else (or an empty VITE_SITE_URL) emits noindex tags and a robots.txt
# that disallows crawling, so previews/staging are never indexed.
VITE_ALLOW_INDEXING=false

# HTTPS endpoint that accepts the quote form as a JSON POST and returns 2xx on success
# (e.g. a Formspree form endpoint or your own serverless function). Leave empty and the
# form is clearly marked as not yet connected; it will never show a false success.
VITE_QUOTE_ENDPOINT=
